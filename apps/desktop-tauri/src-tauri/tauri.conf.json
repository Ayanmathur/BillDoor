{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BillDoor",
  "version": "1.0.0",
  "identifier": "in.billdoor.desktop",
  "build": {
    "devUrl": "https://app.billdoor.in",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BillDoor — Desktop Billing & Management",
        "width": 1280,
        "height": 768,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "copyright": "Copyright © 2026 Orbitex / BillDoor",
    "shortDescription": "BillDoor Desktop App",
    "longDescription": "BillDoor Desktop POS & Business Management Application"
  }
}
